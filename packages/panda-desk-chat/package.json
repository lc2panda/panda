{
  "name": "panda-desk-chat",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "Panda Code desktop chat UI — React + Vite + Tailwind 4",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "ELECTRON=true vite",
    "build": "tsc -b && vite build",
    "build:electron": "ELECTRON=true tsc -b && ELECTRON=true vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed"
  },
  "build": {
    "appId": "com.pandaai.desk-chat",
    "productName": "Panda",
    "copyright": "Copyright © 2026 PandaAI",
    "asar": true,
    "afterPack": "./scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "panda-cli/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../src/utils/model/configs.ts",
        "to": "panda-cli/cli-configs.ts"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Panda"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "lc2panda",
      "repo": "panda"
    }
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.5"
  }
}
