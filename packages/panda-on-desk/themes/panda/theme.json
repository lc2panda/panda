{
  "_comment": "Panda 默认主题 v1.5 — 双路径渲染：v0.x ASCII (sprites/*.ascii) 与 v1.5+ SVG (sprites/*.svg)。SVG 由 scripts/build-sprites.cjs 程序化生成（来源仍为 ASCII，仅多嵌一层矢量包装）。",
  "_pandaSpec": {
    "renderStrategy": "svg-with-ascii-fallback",
    "asciiCanvasRows": 5,
    "asciiCanvasCols": 12,
    "svgViewBoxWidth": 200,
    "svgViewBoxHeight": 200,
    "speciesCount": 18,
    "petStateCount": 12,
    "framesPerState": 3,
    "spriteSource": "src/buddy/sprites.ts BODIES (only-read)",
    "svgGenerator": "scripts/build-sprites.cjs (P3-T5)",
    "todoMilestone": "v1.5 已落 SVG 美术（程序化）；v2.0+ 引入手绘美术替换 (D 阶段)"
  },

  "schemaVersion": 1,
  "id": "panda-default",
  "name": "Panda",
  "author": "panda-on-desk",
  "version": "0.1.0",
  "description": "Panda 默认主题 — ASCII 占位渲染 18 物种 × 12 PetState（A 起步）",
  "license": "MIT",
  "repo": "https://github.com/lc2panda/panda",

  "viewBox": {
    "_comment": "12 字符宽 × 5 行高 ASCII 画布映射到 200×100 SVG 像素（cell ≈ 16×20px 等宽字体）",
    "x": 0,
    "y": 0,
    "width": 200,
    "height": 100
  },

  "layout": {
    "contentBox": { "x": 0, "y": 0, "width": 200, "height": 100 },
    "marginBox":  { "x": -8, "y": -8, "width": 216, "height": 116 },
    "centerX": 100,
    "baselineY": 90,
    "visibleHeightRatio": 0.92,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "_comment": "ASCII 无矢量坐标 — v0.1 关闭 eyeTracking；v0.5 SVG 阶段重新启用",
    "enabled": false,
    "states": [],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.5,
    "maxOffset": 3,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js",
      "dozeEyes": "eyes-doze"
    },
    "shadowOrigin": "100px 90px"
  },

  "states": {
    "_comment": "12 PetState 全覆盖；每条引用 sprites/{species}.ascii — renderer 按 (species, state, frame) 三元组挑选；v0.1 大多数 state 复用 idle 帧，state-driven 差异在 sprites/*.ascii 内 frame 级别注释",
    "idle":         ["sprites/default.ascii"],
    "dozing":       ["sprites/default.ascii"],
    "sleeping":     ["sprites/default.ascii"],
    "waking":       ["sprites/default.ascii"],
    "thinking":     ["sprites/default.ascii"],
    "working":      ["sprites/default.ascii"],
    "juggling":     ["sprites/default.ascii"],
    "carrying":     ["sprites/default.ascii"],
    "sweeping":     ["sprites/default.ascii"],
    "attention":    ["sprites/default.ascii"],
    "notification": ["sprites/default.ascii"],
    "error":        ["sprites/default.ascii"]
  },

  "sleepSequence": { "mode": "direct" },

  "timings": {
    "_comment": "Panda 主题节奏 — 与 clawd 一致（继承 ms 单位）",
    "minDisplay": {
      "attention": 4000, "error": 5000, "sweeping": 5500,
      "notification": 2500, "carrying": 3000, "working": 1000, "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000, "error": 5000, "sweeping": 300000,
      "notification": 2500, "carrying": 3000
    },
    "yawnDuration": 3000,
    "wakeDuration": 1500,
    "deepSleepTimeout": 600000,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "hitBoxes": {
    "default":  { "x": 0,   "y": 0,  "w": 200, "h": 100 },
    "sleeping": { "x": 0,   "y": 40, "w": 200, "h": 60  },
    "wide":     { "x": -8,  "y": -8, "w": 216, "h": 116 }
  },

  "miniMode": { "supported": false },

  "objectScale": {
    "widthRatio": 1.0,
    "heightRatio": 1.0,
    "offsetX": 0,
    "offsetY": 0
  }
}
