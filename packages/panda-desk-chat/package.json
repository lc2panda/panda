{
  "name": "@panda/desk-chat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Panda Code desktop chat UI — React + Vite + Tailwind 4",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "ELECTRON=true vite",
    "build": "tsc -b && vite build",
    "build:electron": "ELECTRON=true tsc -b && ELECTRON=true vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.pandaai.desk-chat",
    "productName": "Panda Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon.icns"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
